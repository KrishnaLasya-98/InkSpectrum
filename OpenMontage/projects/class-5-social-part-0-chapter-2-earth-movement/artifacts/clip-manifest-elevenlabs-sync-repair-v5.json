      "teaching_pages": [
        {
          "text": "Revolution is the movement of the Earth around the Sun in a fixed path called an orbit. The Earth revolves around the Sun in an elliptical orbit.",
          "start_offset_seconds": 0.0,
          "end_offset_seconds": 13.602
        },
        {
          "text": "It takes 365¼ days (one year) to complete one revolution. The tilt of the Earth's axis remains the same during revolution. Revolution causes seasonal changes.",
          "start_offset_seconds": 13.602,
          "end_offset_seconds": 28.525
        },
        {
          "text": "The revolution of the Earth and the tilt of its axis cause different seasons: Summer – The hemisphere tilted towards the Sun experiences summer.",
          "start_offset_seconds": 28.525,
          "end_offset_seconds": 39.367
        },
        {
          "text": "Winter – The hemisphere tilted away from the Sun experiences winter. Spring – Occurs between winter and summer when the temperature starts rising.",
          "start_offset_seconds": 39.367,
          "end_offset_seconds": 50.529
        },
        {
          "text": "Autumn – Occurs between summer and winter when the temperature starts dropping.",
          "start_offset_seconds": 50.529,
          "end_offset_seconds": 56.211
        }
      ]
    },
