      "teaching_pages": [
        {
          "text": "Rotation – Spinning of the Earth on its axis. Revolution – Movement of the Earth around the Sun. Orbit – The path of the Earth around the Sun.",
          "start_offset_seconds": 0.0,
          "end_offset_seconds": 16.004
        },
        {
          "text": "Solstice – When the Sun is at its farthest point north or south. Equinox – When day and night are equal.",
          "start_offset_seconds": 16.004,
          "end_offset_seconds": 24.95
        }
      ]
