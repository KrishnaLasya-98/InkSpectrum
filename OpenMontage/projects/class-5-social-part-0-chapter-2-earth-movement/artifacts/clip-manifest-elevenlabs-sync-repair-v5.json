      "teaching_pages": [
        {
          "text": "The sun falls directly on the equator two times in a year. During this period there is equal length of day and night all over the world.",
          "start_offset_seconds": 0.0,
          "end_offset_seconds": 14.586
        },
        {
          "text": "In Northern Hemisphere, the March Equinox is called the Vernal or Spring Equinox while September Equinox is called Autumnal Equinox.",
          "start_offset_seconds": 14.586,
          "end_offset_seconds": 24.612
        },
        {
          "text": "Spring Equinox (March 21st) marks the beginning of spring. Autumn Equinox (September 23rd) marks the beginning of autumn.",
          "start_offset_seconds": 24.612,
          "end_offset_seconds": 35.36
        }
      ]
    },
