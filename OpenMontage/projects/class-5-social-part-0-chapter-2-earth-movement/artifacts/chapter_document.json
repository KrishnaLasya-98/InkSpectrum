      "page_number": 2,
      "reading_order": 29,
      "block_type": "paragraph",
      "semantic_role": "lesson_content",
      "source_text": "Summer – The hemisphere tilted towards the Sun experiences summer.",
      "required_for_coverage": true,
      "provenance": {
