      "page_number": 2,
      "reading_order": 24,
      "block_type": "paragraph",
      "semantic_role": "lesson_content",
      "source_text": "The Earth rotates at a speed of 1,670 kilometers per hour at the equator, but we don’t feel it because we’re moving along with it!",
