      "page_number": 3,
      "reading_order": 30,
      "block_type": "paragraph",
      "semantic_role": "lesson_content",
      "source_text": "Winter – The hemisphere tilted away from the Sun experiences winter.",
      "required_for_coverage": true,
      "provenance": {
        "source_line_start": 60,
        "source_line_end": 60,
        "extraction_mode": "markdown_fallback"
      },
      "heading": "Revolution"
