      "page_number": 3,
      "reading_order": 31,
      "block_type": "paragraph",
      "semantic_role": "lesson_content",
      "source_text": "Spring – Occurs between winter and summer when the temperature starts rising.",
      "required_for_coverage": true,
      "provenance": {
