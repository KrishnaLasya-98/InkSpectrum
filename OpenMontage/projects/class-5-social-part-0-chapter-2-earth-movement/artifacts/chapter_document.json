      "page_number": 2,
      "reading_order": 28,
      "block_type": "paragraph",
      "semantic_role": "lesson_content",
      "source_text": "The revolution of the Earth and the tilt of its axis cause different seasons:",
      "required_for_coverage": true,
      "provenance": {
        "source_line_start": 54,
        "source_line_end": 54,
        "extraction_mode": "markdown_fallback"
      },
