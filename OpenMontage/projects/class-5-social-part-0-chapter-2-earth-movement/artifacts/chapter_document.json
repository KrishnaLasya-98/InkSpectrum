    {
      "block_id": "p0002-b0012",
      "page_number": 2,
      "reading_order": 26,
      "block_type": "paragraph",
      "semantic_role": "lesson_content",
      "source_text": "Revolution is the movement of the Earth around the Sun in a fixed path called an orbit. The Earth revolves around the Sun in an elliptical orbit. It takes 365¼ days (one year) to complete one revolution. The tilt of the Earth's axis remains the same during revolution. Revolution causes seasonal changes.",
      "required_for_coverage": true,
      "provenance": {
        "source_line_start": 50,
        "source_line_end": 50,
        "extraction_mode": "markdown_fallback"
      },
      "heading": "Revolution"
    },
