      "teaching_pages": [
        {
          "text": "Many ancient civilizations believed that the Earth was flat. However, Greek philosopher Pythagoras was one of the first to suggest that the Earth is spherical.",
          "start_offset_seconds": 0.0,
          "end_offset_seconds": 13.28
        },
        {
          "text": "Later, Aristotle provided evidence by observing how ships disappear over the horizon and how the Earth's shadow on the Moon is curved during a lunar eclipse.",
          "start_offset_seconds": 13.28,
          "end_offset_seconds": 22.16
        },
        {
          "text": "Ferdinand Magellan's voyage around the world further confirmed that the Earth is round.",
          "start_offset_seconds": 22.16,
          "end_offset_seconds": 27.339
        }
      ]
    },
