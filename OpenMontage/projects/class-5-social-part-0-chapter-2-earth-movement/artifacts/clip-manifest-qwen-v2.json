      "teaching_pages": [
        {
          "text": "Revolution is the movement of the Earth around the Sun in a fixed path called an orbit. The Earth revolves around the Sun in an elliptical orbit.",
          "start_offset_seconds": 0.0,
          "end_offset_seconds": 11.161
        },
        {
          "text": "It takes 365\u00bc days (one year) to complete one revolution. The tilt of the Earth's axis remains the same during revolution. Revolution causes seasonal changes.",
          "start_offset_seconds": 11.161,
          "end_offset_seconds": 22.481
        },
        {
          "text": "The revolution of the Earth and the tilt of its axis cause different seasons: Summer \u2013 The hemisphere tilted towards the Sun experiences summer.",
          "start_offset_seconds": 22.481,
          "end_offset_seconds": 29.561
        },
        {
          "text": "Winter \u2013 The hemisphere tilted away from the Sun experiences winter. Spring \u2013 Occurs between winter and summer when the temperature starts rising.",
          "start_offset_seconds": 29.561,
          "end_offset_seconds": 37.161
        },
        {
          "text": "Autumn \u2013 Occurs between summer and winter when the temperature starts dropping.",
          "start_offset_seconds": 37.161,
          "end_offset_seconds": 41.769
        }
      ]
    },
