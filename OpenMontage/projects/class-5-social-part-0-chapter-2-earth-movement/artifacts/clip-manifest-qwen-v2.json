      "teaching_pages": [
        {
          "text": "A solstice is a day, when the sun shines vertically over a Tropic (both cancer and Capricorn) in the afternoon and the day is the longest in that hemisphere.",
          "start_offset_seconds": 0.0,
          "end_offset_seconds": 14.141
        },
        {
          "text": "On 22 December, the rays of the sun fall directly over the Tropic of Capricorn.",
          "start_offset_seconds": 14.141,
          "end_offset_seconds": 19.681
        },
        {
          "text": "This is the longest day in Southern Hemisphere (summer season), while in the Northern Hemisphere, it is the shortest day (winter season). This is called 'Winter Solstice.",
          "start_offset_seconds": 19.681,
          "end_offset_seconds": 28.961
        },
        {
          "text": "On 21 June, sunlight falls vertically over the Tropic of Cancer.",
          "start_offset_seconds": 28.961,
          "end_offset_seconds": 34.401
        },
        {
          "text": "This is the longest day in Northern Hemisphere and hence it is called 'Summer Solstice', while in the Southern Hemisphere, it is the shortest day.",
          "start_offset_seconds": 34.401,
          "end_offset_seconds": 43.44
        }
      ]
    },
