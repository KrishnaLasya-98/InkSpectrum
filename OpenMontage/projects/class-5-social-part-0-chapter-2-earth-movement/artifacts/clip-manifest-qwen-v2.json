        ]
      ],
      "teaching_pages": [
        {
          "text": "The Earth's movements, rotation and revolution, have significant affects on our lives. Rotation causes day and night, while revolution leads to the change of seasons.",
          "start_offset_seconds": 0.0,
          "end_offset_seconds": 11.621
        },
        {
          "text": "Solstices and equinoxes mark the shift in seasons, playing an essential role in our climate and timekeeping.",
          "start_offset_seconds": 11.621,
          "end_offset_seconds": 17.935
        }
      ]
    },
    {
      "section_id": "s14-remember",
      "render_mode": "hyperframes",
      "success": true,
      "visual_segments": [],
      "source_card_intervals": [
        [
          0,
          24.999
        ]
      ],
      "teaching_pages": [
        {
          "text": "The Earth moves in two ways: rotation and revolution. Rotation causes day and night, while revolution causes seasons.",
          "start_offset_seconds": 0.0,
          "end_offset_seconds": 9.901
        },
        {
          "text": "The Earth completes one rotation in 24 hours and one revolution in 365\u00bc days. Solstices occur in June and December, marking the longest and shortest days.",
          "start_offset_seconds": 9.901,
          "end_offset_seconds": 20.241
        },
        {
          "text": "Equinoxes occur in March and September, when day and night are equal.",
          "start_offset_seconds": 20.241,
          "end_offset_seconds": 24.999
        }
      ]
    },
