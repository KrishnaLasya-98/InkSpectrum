      ],
      "teaching_pages": [
        {
          "text": "Rotation \u2013 Spinning of the Earth on its axis. Revolution \u2013 Movement of the Earth around the Sun. Orbit \u2013 The path of the Earth around the Sun.",
          "start_offset_seconds": 0.0,
          "end_offset_seconds": 11.641
        },
        {
          "text": "Solstice \u2013 When the Sun is at its farthest point north or south. Equinox \u2013 When day and night are equal.",
          "start_offset_seconds": 11.641,
          "end_offset_seconds": 18.938
        }
