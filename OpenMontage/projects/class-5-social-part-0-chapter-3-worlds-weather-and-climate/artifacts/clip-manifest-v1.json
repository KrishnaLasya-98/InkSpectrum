      "teaching_pages": [
        {
          "text": "Oceans and seas influence the climate of coastal areas. Water heats up and cools down more slowly than land.",
          "start_offset_seconds": 0.0,
          "end_offset_seconds": 15.055
        },
        {
          "text": "During the day, land heats up faster than water, causing a sea breeze to blow from the sea to the land.",
          "start_offset_seconds": 15.055,
          "end_offset_seconds": 22.799
        },
        {
          "text": "At night, the land cools down quickly, and a land breeze blows from land to the sea. This keeps coastal areas cooler in summer and warmer in winter compared to inland regions.",
          "start_offset_seconds": 22.799,
          "end_offset_seconds": 37.007
        }
      ]
