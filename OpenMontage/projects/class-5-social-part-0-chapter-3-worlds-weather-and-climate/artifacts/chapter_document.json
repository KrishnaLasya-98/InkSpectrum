      "heading": "Humidity"
    },
    {
      "block_id": "p0004-b0007",
      "page_number": 4,
      "reading_order": 34,
      "block_type": "section_heading",
      "semantic_role": "lesson_content",
      "source_text": "Ocean Currents",
      "required_for_coverage": true,
      "provenance": {
        "source_line_start": 71,
        "source_line_end": 71,
        "extraction_mode": "markdown_fallback"
      },
      "heading_level": 2,
      "heading": "Ocean Currents"
    },
    {
      "block_id": "p0004-b0008",
      "page_number": 4,
      "reading_order": 35,
      "block_type": "paragraph",
      "semantic_role": "lesson_content",
      "source_text": "Ocean currents are large movements of water in the oceans. Warm ocean currents make coastal areas warmer, while cold currents bring cool temperatures. For example, the Gulf Stream warms Europe, while the cold Labrador Current cools Canada.",
      "required_for_coverage": true,
      "provenance": {
        "source_line_start": 73,
        "source_line_end": 73,
        "extraction_mode": "markdown_fallback"
      },
      "heading": "Ocean Currents"
    },
