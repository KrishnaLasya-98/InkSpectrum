      },
      "heading": "Distance from the Equator (Latitudes)"
    },
    {
      "block_id": "p0003-b0001",
      "page_number": 3,
      "reading_order": 22,
      "block_type": "section_heading",
      "semantic_role": "lesson_content",
      "source_text": "Altitude",
      "required_for_coverage": true,
      "provenance": {
        "source_line_start": 45,
        "source_line_end": 45,
        "extraction_mode": "markdown_fallback"
      },
      "heading_level": 2,
      "heading": "Altitude"
    },
    {
      "block_id": "p0003-b0002",
      "page_number": 3,
      "reading_order": 23,
      "block_type": "paragraph",
      "semantic_role": "lesson_content",
      "source_text": "Altitude is the height of a place above sea level. Higher altitudes have cooler temperatures because the air is thinner and cannot hold much heat. For example, mountains are colder than plains at the same latitude.",
      "required_for_coverage": true,
      "provenance": {
        "source_line_start": 47,
        "source_line_end": 47,
        "extraction_mode": "markdown_fallback"
      },
      "heading": "Altitude"
    },
    {
      "block_id": "p0003-b0003",
      "page_number": 3,
