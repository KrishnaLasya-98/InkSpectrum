        "alt_text": "Original textbook windward, leeward and rain shadow diagram"
      },
      "heading": "Direction of the Wind"
    },
    {
      "block_id": "p0004-b0004",
      "page_number": 4,
      "reading_order": 31,
      "block_type": "section_heading",
      "semantic_role": "lesson_content",
      "source_text": "Humidity",
      "required_for_coverage": true,
      "provenance": {
        "source_line_start": 65,
        "source_line_end": 65,
        "extraction_mode": "markdown_fallback"
      },
      "heading_level": 2,
      "heading": "Humidity"
    },
    {
      "block_id": "p0004-b0005",
      "page_number": 4,
      "reading_order": 32,
      "block_type": "paragraph",
      "semantic_role": "lesson_content",
      "source_text": "Humidity is the amount of water vapour in the air. Places with high humidity receive more rainfall, while dry areas have less humidity. For example, coastal areas have higher humidity than deserts.",
      "required_for_coverage": true,
      "provenance": {
        "source_line_start": 67,
        "source_line_end": 67,
        "extraction_mode": "markdown_fallback"
      },
      "heading": "Humidity"
    },
