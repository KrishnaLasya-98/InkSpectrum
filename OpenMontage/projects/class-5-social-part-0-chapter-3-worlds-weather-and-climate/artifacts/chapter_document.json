    },
    {
      "block_id": "p0001-b0007",
      "page_number": 1,
      "reading_order": 7,
      "block_type": "bullet",
      "semantic_role": "lesson_content",
      "source_text": "Recognize the climatic zones of the Earth.",
      "required_for_coverage": true,
      "provenance": {
