{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/extracted_content",
  "title": "Extracted PDF Content",
  "description": "PDF content extracted via hybrid OpenDataLoader + Marker pipeline",
  "type": "object",
  "required": ["version", "title", "extraction_tool_used", "confidence_score", "sections"],
  "properties": {
    "version": {"const": "1.0", "type": "string"},
    "title": {"type": "string"},
    "source_pdf": {"type": "string"},
    "extraction_tool_used": {"type": "string", "enum": ["opendataloader_local", "opendataloader_hybrid", "marker_balanced", "hybrid_merge"]},
    "confidence_score": {"type": "number", "minimum": 0, "maximum": 1},
    "total_pages": {"type": "integer", "minimum": 1},
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["section_id", "title", "content", "content_type"],
        "properties": {
          "section_id": {"type": "string"},
          "title": {"type": "string"},
          "content": {"type": "string"},
          "content_type": {"type": "string", "enum": ["theory", "mathematics", "mixed"]},
          "page_start": {"type": "integer"},
          "page_end": {"type": "integer"},
          "equations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["latex", "page_number", "bbox"],
              "properties": {
                "latex": {"type": "string"},
                "page_number": {"type": "integer"},
                "bbox": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4},
                "mathml": {"type": "string"},
                "description": {"type": "string"}
              }
            }
          },
          "tables": {
            "type": "array",
            "items": {"type": "object"}
          },
          "figures": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["path", "caption"],
              "properties": {
                "path": {"type": "string"},
                "caption": {"type": "string"},
                "bbox": {"type": "array", "items": {"type": "number"}}
              }
            }
          }
        }
      }
    },
    "metadata": {"type": "object"}
  },
  "additionalProperties": false
}
