{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://inkspectrum.dev/schemas/pipelines/pipeline.schema.json",
  "title": "PipelineManifest",
  "description": "YAML manifest declaring a production pipeline. Mirrors OpenMontage pipeline_defs schema.",
  "type": "object",
  "required": ["name", "stages"],
  "properties": {
    "name": { "type": "string" },
    "category": {
      "type": "string",
      "enum": [
        "generated",
        "animation",
        "talking_head",
        "cinematic",
        "hybrid",
        "custom",
        "screen_recording"
      ]
    },
    "description": { "type": "string" },
    "mode": { "type": "string" },
    "skill": { "type": "string" },
    "budget_default_usd": { "type": "number", "minimum": 0 },
    "max_revisions_per_stage": { "type": "integer", "minimum": 1 },
    "compatible_playbooks": { "type": "array", "items": { "type": "string" } },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/StageSpec" }
    }
  },
  "definitions": {
    "StageSpec": {
      "type": "object",
      "required": ["name", "skill"],
      "properties": {
        "name": { "type": "string" },
        "skill": { "type": "string" },
        "produces": { "type": "array", "items": { "type": "string" } },
        "tools_available": { "type": "array", "items": { "type": "string" } },
        "checkpoint_required": { "type": "boolean" },
        "human_approval_default": { "type": "boolean" },
        "review_focus": { "type": "array", "items": { "type": "string" } },
        "success_criteria": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
