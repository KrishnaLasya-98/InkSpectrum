{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://inkspectrum.dev/schemas/artifacts/chapter_node.schema.json",
  "title": "ChapterNode",
  "description": "A complete chapter extracted from a textbook PDF.",
  "type": "object",
  "required": [
    "id",
    "number",
    "title",
    "subject",
    "grade",
    "textbook_id",
    "page_range",
    "source_pdf"
  ],
  "properties": {
    "id": { "type": "string" },
    "number": { "type": "integer", "minimum": 1 },
    "title": { "type": "string" },
    "subject": {
      "type": "string",
      "enum": ["english", "math", "science", "social"]
    },
    "grade": { "type": "integer", "minimum": 1, "maximum": 10 },
    "textbook_id": { "type": "string" },
    "learning_objectives": { "type": "array", "items": { "type": "string" } },
    "page_range": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "integer", "minimum": 1 }
    },
    "sections": { "type": "array", "items": { "type": "object" } },
    "source_pdf": { "type": "string" }
  },
  "additionalProperties": true
}
