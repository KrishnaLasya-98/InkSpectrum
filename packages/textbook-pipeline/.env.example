# ═══════════════════════════════════════════════════════════════════
# Textbook Pipeline — Environment Variables
#
# Copy this file to .env and fill in your keys:
#   cp .env.example .env
#
# Phase 1 subjects: english, math, social/evs
# ═══════════════════════════════════════════════════════════════════


# ── LLM (script + scene generation) ────────────────────────────────
# Required. Get a free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Optional fallback (alternative provider)
# OPENAI_API_KEY=your_openai_key_here
# OPENAI_MODEL=gpt-4o-mini


# ── TTS (narration) ────────────────────────────────────────────────
# Edge TTS is free, no API key needed.
# Uncomment to use a specific default voice:
# EDGE_TTS_VOICE=en-US-AriaNeural

# Optional: ElevenLabs for higher quality (paid)
# ELEVENLABS_API_KEY=your_elevenlabs_key_here
# ELEVENLABS_VOICE_ID=your_voice_id_here


# ── Image / Video generation (optional, for scene illustrations) ──
# ModelsLab (your existing OpenMontage stack)
# MODELSLAB_API_KEY=your_modelslab_key_here
# MODELSLAB_IMAGE_MODEL=hidream-o1
# MODELSLAB_VIDEO_MODEL=h3-minimax-start-end-frame


# ── Pipeline config ────────────────────────────────────────────────
# Phase 1 subjects only — GK and others come later
ACTIVE_SUBJECTS=english,math,social

# Default LLM settings
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096

# TTS settings
TTS_RATE=+0%        # e.g. -15% for poetry, +0% for normal
TTS_PITCH=0Hz

# Logging
LOG_LEVEL=INFO
LOG_FILE=                     # leave empty to log to stdout only

# Output
OUTPUT_DIR=./projects